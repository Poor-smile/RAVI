{
  "name": "raavi-markdown-viewer",
  "version": "1.0.0",
  "productName": "راوی",
  "description": "ویور و ویرایشگر دسکتاپ Markdown فارسی",
  "author": "Raavi",
  "main": "desktop/main.mjs",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node desktop/serve.mjs",
    "test": "npm run build && node --import tsx --test tests/mermaid-blocks.test.ts tests/mermaid-samples.test.ts tests/mermaid-viewport.test.ts tests/raavi-assets.test.ts && node --test tests/rendered-html.test.mjs tests/desktop-server.test.mjs && playwright test",
    "test:keyboard": "playwright test tests/keyboard-shortcuts.spec.ts",
    "desktop": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --win dir --x64",
    "desktop:pack": "npm run build && electron-builder --win nsis --x64",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "codemirror": "6.0.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "mermaid": "11.16.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "build": {
    "appId": "ir.raavi.markdown",
    "productName": "راوی",
    "executableName": "Raavi",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "build/icon.svg",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Raavi.Markdown",
        "description": "فایل Markdown راوی"
      },
      {
        "ext": "ravi",
        "name": "Raavi.Document",
        "description": "سند حاشیه‌نویسی راوی"
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Raavi-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "راوی",
      "runAfterFinish": true
    }
  },
  "type": "module"
}
