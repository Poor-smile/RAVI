{
  "name": "raavi-markdown-viewer",
  "version": "1.5.2",
  "productName": "راوی",
  "desktopName": "ir.raavi.markdown",
  "description": "ویور و ویرایشگر دسکتاپ Markdown فارسی",
  "author": "Raavi",
  "homepage": "https://ravi.poorsmile.ir",
  "main": "desktop/main.mjs",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:landing": "node scripts/package-landing.mjs",
    "build:web-static": "npm run build && node scripts/package-web-static.mjs",
    "deploy:worker": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "start": "node desktop/serve.mjs",
    "test": "npm run build && node --import tsx --test tests/back-layer-controller.test.ts tests/mermaid-blocks.test.ts tests/mermaid-samples.test.ts tests/mermaid-scheduler.test.ts tests/mermaid-viewport.test.ts tests/raavi-assets.test.ts tests/word-export.test.ts && node --test tests/rendered-html.test.mjs tests/desktop-server.test.mjs tests/landing-fallback.test.mjs && playwright test && npm run test:back-layers:e2e",
    "test:back-layers": "node --import tsx --test tests/back-layer-controller.test.ts",
    "test:back-layers:e2e": "playwright test --config tests/mobile-back-stack.config.ts",
    "test:keyboard": "playwright test tests/keyboard-shortcuts.spec.ts",
    "desktop": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --win dir --x64",
    "desktop:pack": "npm run build && electron-builder --win nsis --x64",
    "desktop:pack:linux": "npm run build && electron-builder --linux AppImage deb tar.gz --x64",
    "desktop:pack:linux:portable": "npm run build && electron-builder --linux dir --x64 && python scripts/package-linux-portable.py",
    "desktop:pack:mac": "npm run build && electron-builder --mac dmg zip --universal",
    "tauri:frontend:dev": "vite --config vite.tauri.config.ts",
    "tauri:frontend": "vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && node scripts/package-tauri-windows.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "codemirror": "6.0.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "30.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "mermaid": "11.16.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.2.6",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "build": {
    "appId": "ir.raavi.markdown",
    "productName": "راوی",
    "executableName": "Raavi",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "scripts/prune-electron-locales.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "build/icon.svg",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Raavi.Markdown",
        "description": "فایل Markdown راوی"
      },
      {
        "ext": "ravi",
        "name": "Raavi.Document",
        "description": "سند حاشیه‌نویسی راوی"
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Raavi-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.svg",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Raavi-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.svg",
      "executableName": "raavi",
      "category": "Office",
      "synopsis": "Persian Markdown viewer and editor",
      "description": "A local-first Persian Markdown viewer and editor with RTL/LTR handling, annotations, Mermaid diagrams, and portable .ravi documents.",
      "maintainer": "Raavi",
      "vendor": "Raavi",
      "mimeTypes": [
        "text/markdown",
        "application/x-raavi"
      ],
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Raavi-${version}-${arch}.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "راوی",
      "runAfterFinish": true
    }
  },
  "type": "module",
  "dependencies": {
    "docx": "^9.7.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.1"
  }
}
